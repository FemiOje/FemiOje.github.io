---
interface Props {
  /** The small word above the heading; leave it out for the heading alone. */
  label?: string;
  id: string;
  class?: string;
}
const { label, id, class: className = 'ma-h2' } = Astro.props;
---

<div class="ma-section-head">
  <div class="ma-section-head__text">
    {label && <p class="ma-label">{label}</p>}
    <h2 id={id} class={className}><slot /></h2>
  </div>
</div>
