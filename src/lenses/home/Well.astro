---
import { Image } from 'astro:assets';
import { coverOf, type Project } from '../../lib/content';

interface Props {
  project: Project;
  class?: string;
  sizes: string;
  loading?: 'lazy' | 'eager';
  /** On cards the title beside the image already names it, so the image stays silent. */
  decorative?: boolean;
}
const { project, class: className, sizes, loading = 'lazy', decorative = false } = Astro.props;
const { title } = project.data;
const cover = coverOf(project);
---

<div class:list={['ma-well', className]}>
  {
    cover ? (
      <Image
        src={cover}
        alt={decorative ? '' : `${title} cover image`}
        widths={[480, 800, 1200]}
        sizes={sizes}
        loading={loading}
        data-tall={cover.height > cover.width || undefined}
      />
    ) : (
      <p class="ma-label">[project screenshot]</p>
    )
  }
</div>
