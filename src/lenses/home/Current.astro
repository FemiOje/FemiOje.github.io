---
import type { Project } from '../../lib/content';
import { workHref } from '../../lib/lenses';

interface Props {
  /** The projects still in progress: a quiet note of what is on the desk, not a showcase. */
  projects: Project[];
}
const { projects } = Astro.props;
---

<section class="ma-current ma-container" aria-labelledby="current">
  <h2 class="ma-label" id="current">currently working on</h2>
  <ul class="ma-current__list">
    {
      projects.map(({ data: { title, slug, summary, stack } }) => (
        <li>
          <h3 class="ma-project__title">
            <a href={workHref('home', slug)}>{title}</a>
          </h3>
          <p class="ma-soft">{summary}</p>
          <p class="ma-label">{stack.join(' · ')}</p>
        </li>
      ))
    }
  </ul>
</section>
