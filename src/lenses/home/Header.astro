---
import { getProfile } from '../../lib/content';
import Mark from '../../lib/Mark.astro';
import LensAlcove from './LensAlcove.astro';

const { data: profile } = await getProfile();
---

<header class="ma-header ma-container">
  <a class="ma-brand" href="/" aria-label={`${profile.name}, home`}>
    <Mark class="ma-mark" />
  </a>
  <button class="ma-menu" type="button" aria-expanded="false" aria-controls="lens-alcove" aria-label="lenses" data-drawer-toggle>
    <svg viewBox="0 0 22 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path class="ma-menu__line" d="M0 2h22"></path>
      <path class="ma-menu__line" d="M0 8h22"></path>
      <path class="ma-menu__line" d="M0 14h22"></path>
    </svg>
  </button>
  <div class="ma-scrim" aria-hidden="true"></div>
  <LensAlcove />
</header>
