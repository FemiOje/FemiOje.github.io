---
import { Font } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import Header from './Header.astro';
import Footer from './Footer.astro';
import './ma.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-lens="home" transition:animate={fade({ duration: '240ms' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4F0E6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-mincho" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-gothic" preload />
    <ClientRouter />
  </head>
  <body>
    <a class="ma-skip" href="#main">skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../../lib/client/lens-memory';
      import '../../lib/client/clock';
      import '../../lib/client/project-filter';
    </script>
  </body>
</html>
