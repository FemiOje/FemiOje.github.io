---
// The running head: sticky, like a fancyhdr header. `[data-runhead-section]` follows the section in view.
import { getProfile } from '../../lib/content';
import MenuIcon from './MenuIcon.astro';

const { data: profile } = await getProfile();
const [first, ...rest] = profile.name.toLowerCase().split(' ');
---

<header class="runhead container mono">
  <a class="runhead-name" href="/blockchain">{first[0]}. {rest.join(' ')}: onchain systems</a>
  <p class="runhead-meta">
    <span data-runhead-section>title</span>
  </p>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="lens-menu" aria-label="lenses" data-drawer-toggle>
    <MenuIcon name="menu" />
  </button>
</header>
