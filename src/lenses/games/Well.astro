---
import { Image } from 'astro:assets';
import type { Project } from '../../lib/content';

interface Props {
  project: Project;
  class?: string;
  sizes: string;
  loading?: 'lazy' | 'eager';
}
const { project, class: className, sizes, loading = 'lazy' } = Astro.props;
const { cover, title } = project.data;
---

<div class:list={['br-well', className]}>
  {
    cover ? (
      <Image src={cover} alt={`${title} screenshot`} widths={[480, 800, 1200]} sizes={sizes} loading={loading} />
    ) : (
      <p>[project screenshot]</p>
    )
  }
</div>
