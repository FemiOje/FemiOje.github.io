---
import type { Project } from '../../lib/content';
import { workHref } from '../../lib/lenses';
import Status from './Status.astro';
import Well from './Well.astro';

interface Props {
  project: Project;
  /** Model number, e.g. `fo-01`. */
  model: string;
}
const { project, model } = Astro.props;
const { title, slug, summary, status, stack } = project.data;
---

<li class="br-unit">
  <Well project={project} sizes="(min-width: 1100px) 380px, (min-width: 768px) 45vw, 90vw" />
  <div class="br-unit__meta">
    <span>{model}</span>
    <Status status={status} />
  </div>
  <div class="br-unit__body">
    <h3 class="br-unit__title"><a href={workHref('games', slug)}>{title}</a></h3>
    <p>{summary}</p>
  </div>
  <p class="br-label">{stack.map((item) => item.toLowerCase()).join(' · ')}</p>
</li>
