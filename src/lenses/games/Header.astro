---
import { getProfile } from '../../lib/content';
import MenuIcon from './MenuIcon.astro';

const { data: profile } = await getProfile();
---

<header class="site-header container">
  <a class="brand" href="/games">
    <canvas data-brand width="20" height="20" aria-hidden="true"></canvas>
    <span class="brand-name">{profile.name}</span>
  </a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="lens-menu" aria-label="lenses" data-drawer-toggle>
    <MenuIcon name="menu" />
  </button>
</header>
