---
interface Props {
  /** e.g. `01 — selected work` */
  label: string;
  id: string;
  /** Optional readout on the right, e.g. `03 units`. */
  count?: string;
  class?: string;
}
const { label, id, count, class: className = 'br-h2' } = Astro.props;
---

<div class="br-section-head">
  <div class="br-section-head__text">
    <p class="br-label br-muted">{label}</p>
    <h2 id={id} class={className}><slot /></h2>
  </div>
  {count && <p class="br-label br-muted">{count}</p>}
</div>
