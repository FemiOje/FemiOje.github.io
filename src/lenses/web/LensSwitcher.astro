---
import { lenses } from '../../lib/lenses';
---

<nav class="sw-lens" aria-label="Choose a lens">
  <ul>
    {
      lenses.map(({ id, href, ready }) => (
        <li>
          {ready ? (
            <a class="sw-lens__item" href={href} data-lens-link={id} aria-current={id === 'web' ? 'page' : undefined}>
              {id}
            </a>
          ) : (
            <span class="sw-lens__item" aria-disabled="true">
              {id}
              <span class="sw-visually-hidden">, coming soon</span>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>
