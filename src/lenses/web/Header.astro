---
import { getProfile } from '../../lib/content';
import LensSwitcher from './LensSwitcher.astro';

const { data: profile } = await getProfile();
const sections = ['work', 'about', 'contact'];
---

<header class="br-header">
  <div class="br-header__row br-container">
    <a class="br-wordmark" href="/web">{profile.name.toLowerCase()}</a>
    <nav class="br-nav" aria-label="Sections">
      <ul>
        {sections.map((id) => <li><a href={`/web#${id}`}>{id}</a></li>)}
      </ul>
    </nav>
    <LensSwitcher />
    <p class="br-clock">
      lagos<span data-clock={profile.timeZone} hidden> · <time></time> wat</span>
    </p>
  </div>
</header>
