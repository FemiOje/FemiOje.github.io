---
// Sits inside the top (ultramarine) field of each page, above that page's own content.
import { getProfile } from '../../lib/content';
import LensSwitcher from './LensSwitcher.astro';

const { data: profile } = await getProfile();
---

<header class="sw-header">
  <a class="sw-name" href="/web">{profile.name}</a>
  <LensSwitcher />
  <div class="sw-header__tools">
    <p>
      lagos<span data-clock={profile.timeZone} hidden>{' '}<time></time></span>
    </p>
    <button class="sw-toggle" type="button" aria-pressed="false" data-grid-toggle>grid</button>
  </div>
</header>
