---
import { getProfile } from '../../lib/content';
import Seal from './Seal.astro';
import LensSwitcher from './LensSwitcher.astro';

const { data: profile } = await getProfile();
const sections = ['work', 'about', 'contact'];
---

<header class="ma-header ma-container">
  <a class="ma-brand" href="/">
    <Seal />
    {profile.name}
  </a>
  <nav class="ma-nav" aria-label="Sections">
    <ul>
      {sections.map((id) => <li><a href={`/#${id}`}>{id}</a></li>)}
    </ul>
  </nav>
  <LensSwitcher />
  <p class="ma-clock">
    lagos<span data-clock={profile.timeZone} hidden> · <time></time></span>
  </p>
</header>

<script>
  let timer: ReturnType<typeof setInterval> | undefined;

  document.addEventListener('astro:page-load', () => {
    clearInterval(timer);
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    const time = clock?.querySelector('time');
    if (!clock || !time) return;

    const format = new Intl.DateTimeFormat('en-GB', {
      timeZone: clock.dataset.clock,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      const now = new Date();
      time.textContent = format.format(now);
      time.dateTime = now.toISOString();
    };
    tick();
    clock.hidden = false;
    timer = setInterval(tick, 15_000);
  });
</script>
