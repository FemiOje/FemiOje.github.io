---
import type { MotifKind } from './poster';

interface Props {
  kind: MotifKind;
}
const { kind } = Astro.props;
const shapes: Record<MotifKind, number> = { circle: 2, bars: 4, quarter: 2 };
---

<div class:list={['sw-motif', `sw-motif--${kind}`]} aria-hidden="true">
  {Array.from({ length: shapes[kind] }, () => <span />)}
</div>
