---
// The lens's own thin stroke icons: generic browser and inspector chrome, no one's trade dress.
// Each icon is drawn for the size it appears at, never scaled from another size.
const icons = {
  16: {
    back: 'M10 3 5 8l5 5',
    forward: 'M6 3l5 5-5 5',
    reload: 'M13 8a5 5 0 1 1-1.5-3.5M13 2v3h-3',
    code: 'M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5',
    pick: 'M13 6V3H3v10h3M8 8l5.5 2-2.3 1.2-1.2 2.3z',
    phone: 'M5 2h6v12H5zM7.5 11.5h1',
    close: 'M4 4l8 8M12 4l-8 8',
    arrowLeft: 'M14 8H3M7 4 3 8l4 4',
  },
  12: {
    lock: 'M2.5 5.5h7v5h-7zM4 5.5V4a2 2 0 0 1 4 0v1.5',
  },
};
const strokes = { 16: 1.5, 12: 1.4 };

type Props = { name: keyof (typeof icons)[16]; size?: 16 } | { name: keyof (typeof icons)[12]; size: 12 };
const { name, size = 16 } = Astro.props;
const d = (icons[size] as Record<string, string>)[name];
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  fill="none"
  stroke="currentColor"
  stroke-width={strokes[size]}
  stroke-linecap="square"
  aria-hidden="true"
>
  <path d={d}></path>
</svg>
