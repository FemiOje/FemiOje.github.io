---
interface Props {
  /** e.g. `01` */
  numeral: string;
  /** e.g. `selected work` */
  label: string;
  id: string;
}
const { numeral, label, id } = Astro.props;
---

<div class="sw-section-head">
  <div class="sw-section-head__title">
    <span class="sw-numeral" aria-hidden="true">{numeral}</span>
    <div>
      <p class="sw-section-label">{label}</p>
      <h2 class="sw-h2" id={id}><slot /></h2>
    </div>
  </div>
  <slot name="controls" />
</div>
