---
import { Image } from 'astro:assets';
import { coverOf, factLabel, getLensProjects, statusLabel, type Project } from '../../../lib/content';
import { workHref } from '../../../lib/lenses';
import Header from '../../../lenses/web/Header.astro';
import Icon from '../../../lenses/web/Icon.astro';
import Layout from '../../../lenses/web/Layout.astro';
import Motif from '../../../lenses/web/Motif.astro';
import { pad, posterField, posterMotif } from '../../../lenses/web/poster';

export async function getStaticPaths() {
  const { featuredFirst: projects } = await getLensProjects('web');
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: { project, index, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  /** Place in the lens order; the same number, field and motif as its poster card. */
  index: number;
  next: Project;
}
const { project, index, next } = Astro.props;
const { title, summary, role, status, stack, links, years, facts, onchain } = project.data;
const cover = coverOf(project);

const outbound = [
  { label: 'live', url: links.live, missing: '[live link]' },
  { label: 'repo', url: links.repo, missing: '[repo link]' },
  ...(onchain ? [{ label: onchain.network.toLowerCase(), url: onchain.url, missing: '' }] : []),
];
---

<Layout title={`${title} — Femi Ojetokun`} description={summary}>
  <article>
    <header class="sw-hero sw-hero--sheet sw-on-blue">
      <div class="sw-container sw-hero__inner">
        <Header />
        <div class="sw-sheet__head" id="content" tabindex="-1">
          <a class="sw-back" href="/web#work">
            <Icon name="arrow" />
            all work
          </a>
          <p class="sw-sheet__meta">
            <span class="sw-numeral" aria-hidden="true">{pad(index + 1)}</span>
            <span>{statusLabel[status]}</span>
          </p>
          <h1 class="sw-h1">{title}</h1>
          <p class="sw-lead">{summary}</p>
        </div>
      </div>
    </header>

    <div class="sw-section sw-on-paper">
      <div class="sw-container sw-sheet">
        <dl class="sw-table">
          <div>
            <dt>role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>stack</dt>
            <dd>{stack.join(' · ')}</dd>
          </div>
          <div>
            <dt>status</dt>
            <dd>{statusLabel[status]}</dd>
          </div>
          <div>
            <dt>links</dt>
            <dd>
              <ul>
                {outbound.map(({ label, url, missing }) => <li>{url ? <a href={url}>{label}</a> : missing}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt>years</dt>
            <dd>{years}</dd>
          </div>
        </dl>

        <div class="sw-sheet__main">
          {
            cover ? (
              <div class="sw-frame sw-frame--cover">
                <div class="sw-cover">
                  <Image
                    src={cover}
                    alt={`${title} screenshot`}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1280px) 690px, (min-width: 900px) 55vw, 92vw"
                    loading="eager"
                  />
                </div>
              </div>
            ) : (
              <div class="sw-frame" data-field={posterField(index)}>
                <p class="sw-label">[project screenshot]</p>
                <Motif kind={posterMotif(index)} />
              </div>
            )
          }

          {
            facts.length > 0 && (
              <dl class="sw-table sw-facts">
                {facts.map(({ k, v }) => (
                  <div>
                    <dt>{factLabel(k)}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            )
          }

          {
            next !== project && (
              <a class="sw-btn sw-btn--secondary sw-sheet__next" href={workHref('web', next.data.slug)}>
                next — {next.data.title}
                <Icon name="arrow" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </article>
</Layout>
