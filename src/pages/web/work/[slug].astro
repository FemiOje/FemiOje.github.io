---
import { Image } from 'astro:assets';
import { coverOf, factLabel, galleryOf, getLensProjects, statusLabel, type Project } from '../../../lib/content';
import { workHref } from '../../../lib/lenses';
import Icon from '../../../lenses/web/Icon.astro';
import Layout from '../../../lenses/web/Layout.astro';

export async function getStaticPaths() {
  const { featuredFirst: projects } = await getLensProjects('web');
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: { project, index, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  /** Place in the lens order; the same number as its card. */
  index: number;
  next: Project;
}
const { project, index, next } = Astro.props;
const { title, summary, role, status, stack, links, years, facts, onchain } = project.data;
const cover = coverOf(project);

// The primary action is the live site when there is one, the repo otherwise.
const actions = [
  { label: 'visit the live site', url: links.live },
  { label: 'view the repo', url: links.repo },
].filter(({ url }) => url);
const outbound = [
  { label: 'live', url: links.live, missing: '[live link]' },
  { label: 'repo', url: links.repo, missing: '[repo link]' },
  ...(onchain ? [{ label: onchain.network.toLowerCase(), url: onchain.url, missing: '' }] : []),
];
const specs = [
  { label: 'role', value: role },
  { label: 'stack', value: stack.join(' · ') },
  { label: 'status', value: statusLabel[status] },
  { label: 'years', value: years },
  ...facts.map(({ k, v }) => ({ label: factLabel(k), value: v })),
];
---

<Layout title={`${title} — Femi Ojetokun`} description={summary}>
  <article>
    <header class="hero">
      <a class="back" href="/web#work">
        <Icon name="arrowLeft" />
        all work
      </a>
      <span class="hero__label">{String(index + 1).padStart(2, '0')} · {statusLabel[status]}</span>
      <h1 class="hero__title" data-inspect="h1">{title}</h1>
      <p class="hero__lead" data-inspect="lead">{summary}</p>
      {
        actions.length > 0 && (
          <div class="hero__actions">
            {actions.map(({ label, url }, i) =>
              i === 0 ? (
                <a class="btn" href={url} data-inspect="cta">
                  {label}
                </a>
              ) : (
                <a class="text-link" href={url}>
                  {label}
                </a>
              ),
            )}
          </div>
        )
      }
    </header>

    <div class="sheet">
      <div class="card__well">
        {
          cover ? (
            <Image
              src={cover}
              alt={`${title} screenshot`}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1100px) 784px, 92vw"
              loading="eager"
              data-tall={cover.height > cover.width || undefined}
            />
          ) : (
            '[project screenshot]'
          )
        }
      </div>
      {
        galleryOf(project).map(({ image, alt }) => (
          <div class="card__well">
            <Image
              src={image}
              alt={alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1100px) 784px, 92vw"
              data-tall={image.height > image.width || undefined}
            />
          </div>
        ))
      }

      <dl class="facts" data-inspect="specs">
        {
          specs.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
        <div>
          <dt>links</dt>
          <dd>
            <ul>
              {outbound.map(({ label, url, missing }) => <li>{url ? <a href={url}>{label}</a> : missing}</li>)}
            </ul>
          </dd>
        </div>
      </dl>

      {
        next !== project && (
          <a class="text-link" href={workHref('web', next.data.slug)}>
            next: {next.data.title}
          </a>
        )
      }
    </div>
  </article>
</Layout>
