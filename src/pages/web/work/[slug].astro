---
import { render } from 'astro:content';
import { getLensProjects, type Project } from '../../../lib/content';
import { workHref } from '../../../lib/lenses';
import { modelNumber } from '../../../lib/models';
import Layout from '../../../lenses/web/Layout.astro';
import Status from '../../../lenses/web/Status.astro';
import Well from '../../../lenses/web/Well.astro';

export async function getStaticPaths() {
  const { featuredFirst: units } = await getLensProjects('web');
  return units.map((project, i) => ({
    params: { slug: project.data.slug },
    props: { project, model: modelNumber(i), next: units[(i + 1) % units.length] },
  }));
}

interface Props {
  project: Project;
  model: string;
  next: Project;
}
const { project, model, next } = Astro.props;
const { title, summary, role, status, stack, links, years } = project.data;
const { Content } = await render(project);

const outbound = [
  { label: 'live', url: links.live, missing: '[live link]' },
  { label: 'repo', url: links.repo, missing: '[repo link]' },
];
---

<Layout title={`${title} — data sheet — Femi Ojetokun`} description={summary}>
  <article class="br-sheet br-container">
    <header class="br-sheet__head">
      <p class="br-sheet__meta">
        <span>{model}</span>
        <Status status={status} />
        <span>data sheet</span>
      </p>
      <h1 class="br-h1">{title}</h1>
      <p class="br-lead">{summary}</p>
    </header>

    <dl class="br-table">
      <div>
        <dt class="br-label br-muted">role</dt>
        <dd>{role.toLowerCase()}</dd>
      </div>
      <div>
        <dt class="br-label br-muted">stack</dt>
        <dd>{stack.map((item) => item.toLowerCase()).join(' · ')}</dd>
      </div>
      <div>
        <dt class="br-label br-muted">status</dt>
        <dd><Status status={status} /></dd>
      </div>
      <div>
        <dt class="br-label br-muted">links</dt>
        <dd>
          <ul>
            {
              outbound.map(({ label, url, missing }) => (
                <li>{url ? <a class="br-link" href={url}>{label}</a> : missing}</li>
              ))
            }
          </ul>
        </dd>
      </div>
      <div>
        <dt class="br-label br-muted">years</dt>
        <dd>{years}</dd>
      </div>
    </dl>

    <Well project={project} class="br-sheet__well" sizes="(min-width: 1280px) 1184px, 92vw" loading="eager" />

    <div class="br-prose"><Content /></div>

    {
      next !== project && (
        <a class="br-next br-link" href={workHref('web', next.data.slug)}>
          next unit — {next.data.title.toLowerCase()}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 8h12M9.5 3.5 14 8l-4.5 4.5" />
          </svg>
        </a>
      )
    }
  </article>
</Layout>
