---
import { getExperience, getLensProjects, getProfile, type Project } from '../lib/content';
import Layout from '../lenses/home/Layout.astro';
import BambooDivider from '../lenses/home/BambooDivider.astro';
import Desk from '../lenses/home/Desk.astro';
import Filters from '../lenses/home/Filters.astro';
import Rows from '../lenses/home/Rows.astro';
import SectionHead from '../lenses/home/SectionHead.astro';
import ShojiGrid from '../lenses/home/ShojiGrid.astro';
import Tokonoma from '../lenses/home/Tokonoma.astro';
import WorkList from '../lenses/home/WorkList.astro';

const profile = await getProfile();
const { name, role, bio, intro, email, links } = profile.data;
const { all, featured, rest } = await getLensProjects('home');
const experience = await getExperience();
// Work in progress sits on the hero's desk; the selected work holds only finished work.
const inProgress = ({ data }: Project) => data.status === 'in-progress';
const current = all.filter(inProgress);
const work = all.filter((project) => !inProgress(project));
const showcase = featured && !inProgress(featured) ? featured : undefined;
// One object in the alcove, five in the shoji, the rest as quiet rows.
const remaining = rest.filter((project) => !inProgress(project));
const shoji = remaining.slice(0, 5);
const others = remaining.slice(5);
---

<Layout title={`${name}, ${role.replace(/\b\w/g, (c) => c.toUpperCase())}`} description={profile.data.meta.home}>
  <section class="ma-hero" aria-labelledby="hero-title">
    <div class="ma-container ma-hero__row">
      <div class="ma-hero__stack">
        <h1 class="ma-h1" id="hero-title">{name}, {role.toLowerCase()}.</h1>
        <p class="ma-lead">{intro.home}</p>
        <div class="ma-actions">
          <a class="ma-enter" href="#work">view my work</a>
          <a class="ma-link" href="#contact">contact me</a>
        </div>
      </div>
      <Desk projects={current} />
    </div>
  </section>

  <div class="ma-container"><BambooDivider at="30%" /></div>

  <section class="ma-work ma-container" aria-labelledby="work">
    <div class="ma-blocks">
      <div class="ma-work__head">
        <SectionHead id="work">Selected work</SectionHead>
        <Filters projects={work} />
      </div>
      {showcase && <Tokonoma project={showcase} />}
      {shoji.length > 0 && <ShojiGrid projects={shoji} />}
      {others.length > 0 && <WorkList projects={others} />}
    </div>
  </section>

  <section class="ma-about ma-container" aria-labelledby="about">
    <div class="ma-blocks">
      <SectionHead label="about" id="about">Background</SectionHead>
      <div class="ma-about__body">
        <div class="ma-bio">{bio.map((paragraph) => <p>{paragraph}</p>)}</div>
        <Rows
          rows={experience.map(({ data }) => ({
            ...data,
            detail: [data.detail, data.years].filter(Boolean).join(' · '),
          }))}
        />
      </div>
    </div>
  </section>

  <section class="ma-contact ma-container" aria-labelledby="contact">
    <div class="ma-blocks">
      <SectionHead label="contact" id="contact" class="ma-contact__headline">
        Leave a note at the door.
      </SectionHead>
      <ul class="ma-contact__links">
        <li>
          <span class="ma-label">email</span>
          {email.startsWith('[') ? <span>{email}</span> : <a class="ma-link" href={`mailto:${email}`}>{email}</a>}
        </li>
        {
          links.map(({ label, url, text }) => (
            <li>
              <span class="ma-label">{label}</span>
              <a class="ma-link" href={url}>{text ?? url.replace(/^https?:\/\//, '')}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
